        {
          "id": "approve_publish_now",
          "label": "Approve this draft and publish it immediately",
          "row": true,
          "consequential": true,
          "timeout_s": 45,
          "verifies": "ContentVersion"
        },
        {
          "id": "reject",
          "label": "Reject this draft with the feedback field",
          "row": true,
          "consequential": true,
          "timeout_s": 45,
          "verifies": "ContentVersion"
        }
      ]
    },
