  "surfaces": [
    {
      "id": "connections.form",
      "route": "/connections",
      "title": "Connect database form",
      "purpose": "Create a new MySQL connection profile (or edit one). Fill the fields, ask the user to type the password in the form, Test, then Save.",
      "openable": true,
      "fields": [
        {
          "name": "name",
          "label": "Connection display name",
          "type": "text",
          "required": true
        },
        {
          "name": "host",
          "label": "Host / address",
          "type": "text",
          "required": true
        },
        {
          "name": "port",
          "label": "Port",
          "type": "number",
          "required": true
        },
        {
          "name": "database_name",
          "label": "Database name",
          "type": "text",
          "required": true
        },
        {
          "name": "username",
          "label": "Username",
          "type": "text",
          "required": true
        },
        {
          "name": "password",
          "label": "Password",
          "type": "secret",
          "required": true
        },
        {
          "name": "ssl_mode",
          "label": "SSL mode",
          "type": "select",
          "required": false,
          "enum": [
            "preferred",
            "required",
            "disabled"
          ]
        }
      ],
      "actions": [
        {
          "id": "test",
          "label": "Test Connection",
          "consequential": false,
          "timeout_s": 45
        },
        {
          "id": "save",
          "label": "Save Profile",
          "consequential": false,
          "timeout_s": 45,
          "verifies": "DbConnection"
        },
        {
          "id": "cancel",
          "label": "Cancel / close the form",
          "consequential": false,
          "timeout_s": 10
        }
      ]
    },
    {
      "id": "connections.list",
      "route": "/connections",
      "title": "Saved connections",
      "purpose": "Cards for each saved connection with status. Row actions take the connection id as row.",
      "openable": false,
      "fields": [],
      "actions": [
        {
          "id": "test",
          "label": "Test this saved connection",
          "row": true,
          "consequential": false,
          "timeout_s": 45,
          "verifies": "DbConnection"
        },
        {
          "id": "refresh_schema",
          "label": "Rescan schema",
          "row": true,
          "consequential": false,
          "timeout_s": 90,
          "verifies": "DbConnection"
        },
        {
          "id": "edit",
          "label": "Open the edit form for this connection",
          "row": true,
          "consequential": false,
          "timeout_s": 10
        },
        {
          "id": "remove",
          "label": "Remove this connection profile (does not touch the database)",
          "row": true,
          "consequential": true,
          "timeout_s": 30,
          "destructive": true
        }
      ]
    },
    {
      "id": "explorer.browser",
      "route": "/explorer",
      "title": "Schema explorer",
      "purpose": "Pick a connection and a table to inspect columns, safety tier and relations; add a note; rescan.",
      "openable": false,
      "fields": [
        {
          "name": "connection",
          "label": "Target database connection",
          "type": "searchable_select",
          "required": true
        },
        {
          "name": "table",
          "label": "Table",
          "type": "searchable_select",
          "required": false
        },
        {
          "name": "note",
          "label": "Workspace note for the selected table",
          "type": "textarea",
          "required": false
        }
      ],
      "actions": [
        {
          "id": "refresh",
          "label": "Rescan schema",
          "consequential": false,
          "timeout_s": 90
        },
        {
          "id": "save_note",
          "label": "Save table note",
          "consequential": false,
          "timeout_s": 20
        }
      ]
    },
    {
      "id": "data.page",
      "route": "/data",
      "title": "Data",
      "purpose": "Rows of the user's own tables. Choose the connection and table, search, then open the add-row form or the AI sample rows window. Adding, editing or deleting always ends in the page's own preview, confirmed by the user; there is no action here that writes rows.",
      "openable": false,
      "fields": [
        {
          "name": "connection",
          "label": "Connection",
          "type": "searchable_select",
          "required": true
        },
        {
          "name": "table",
          "label": "Table",
          "type": "searchable_select",
          "required": true
        },
        {
          "name": "search",
          "label": "Search the rows",
          "type": "text",
          "required": false
        }
      ],
      "actions": [
        {
          "id": "refresh",
          "label": "Reload the rows",
          "consequential": false,
          "timeout_s": 30
        },
        {
          "id": "add_row",
          "label": "Open the add-row form",
          "consequential": false,
          "timeout_s": 10
        },
        {
          "id": "sample_rows",
          "label": "Open the AI sample rows window",
          "consequential": false,
          "timeout_s": 10
        }
      ]
    },
    {
      "id": "automations.list",
      "route": "/automations",
      "title": "Automations",
      "purpose": "Every automation with its schedule and status. Row actions take the automation id as row.",
      "openable": false,
      "fields": [],
      "actions": [
        {
          "id": "run_now",
          "label": "Run this automation now",
          "row": true,
          "consequential": true,
          "timeout_s": 30,
          "verifies": "Automation"
        },
        {
          "id": "pause",
          "label": "Pause this automation (no change if already paused)",
          "row": true,
          "consequential": true,
          "timeout_s": 20,
          "verifies": "Automation"
        },
        {
          "id": "resume",
          "label": "Resume (activate) this automation (no change if already active)",
          "row": true,
          "consequential": true,
          "timeout_s": 20,
          "verifies": "Automation"
        },
        {
          "id": "toggle",
          "label": "Pause or activate this automation",
          "row": true,
          "consequential": true,
          "timeout_s": 20,
          "verifies": "Automation"
        },
        {
          "id": "remove",
          "label": "Delete this automation",
          "row": true,
          "consequential": true,
          "timeout_s": 20,
          "destructive": true
        },
        {
          "id": "new",
          "label": "Open the automation builder",
          "consequential": false,
          "timeout_s": 10
        }
      ]
    },
    {
      "id": "builder.setup",
      "route": "/automations/new",
      "title": "Automation builder, step 1: connection and table",
      "purpose": "Name the automation and choose the connection, target table and content mode (AI or fixed values). Automations insert new rows. Then Next.",
      "openable": false,
      "fields": [
        {
          "name": "name",
          "label": "Automation name",
          "type": "text",
          "required": true
        },
        {
          "name": "connection",
          "label": "Target connection",
          "type": "searchable_select",
          "required": true
        },
        {
          "name": "table",
          "label": "Target table",
          "type": "searchable_select",
          "required": true
        },
        {
          "name": "operation",
          "label": "Operation (automations insert new rows)",
          "type": "select",
          "required": true,
          "enum": [
            "INSERT"
          ]
        },
        {
          "name": "mode",
          "label": "Content mode",
          "type": "select",
          "required": true,
          "enum": [
            "AI_GENERATED",
            "MANUAL"
          ]
        },
        {
          "name": "plan_prompt",
          "label": "Describe the automation in words (AI plan proposal)",
          "type": "textarea",
          "required": false
        }
      ],
      "actions": [
        {
          "id": "propose_plan",
          "label": "Let AI propose a plan from the description",
          "consequential": false,
          "timeout_s": 240
        },
        {
          "id": "next",
          "label": "Next step",
          "consequential": false,
          "timeout_s": 15
        }
      ]
    },
    {
      "id": "builder.mappings",
      "route": "/automations/new",
      "title": "Automation builder, step 2: field mappings",
      "purpose": "Each column of the target table and how it is filled. read_screen lists every column with its current choice (how), the allowed choices, what it means in plain English (means) and any problem. Change a column with choose_option on how.<column> (AI, AI_CREATE = AI picks a linked record and creates it if new, AI_REUSE = only existing linked records, FIXED, FIXED_REL = one fixed linked record, SLUG, NOW = publication time, EMPTY, DEFAULT). Set a fixed value or linked record with value.<column> and extra AI guidance (for example which category to prefer) with instructions.<column>. Protected columns cannot be set. Then Next.",
      "openable": false,
      "fields": [
        {
          "name": "how.*",
          "label": "How a column is filled (how.<column>)",
          "type": "select",
          "required": false,
          "dynamic": true
        },
        {
          "name": "value.*",
          "label": "Fixed value or linked record for a column (value.<column>)",
          "type": "text",
          "required": false,
          "dynamic": true
        },
        {
          "name": "instructions.*",
          "label": "Extra AI instructions for one AI-filled column (instructions.<column>)",
          "type": "textarea",
          "required": false,
          "dynamic": true
        }
      ],
      "actions": [
        {
          "id": "back",
          "label": "Previous step",
          "consequential": false,
          "timeout_s": 10
        },
        {
          "id": "next",
          "label": "Next step",
          "consequential": false,
          "timeout_s": 15
        }
      ]
    },
    {
      "id": "builder.content",
      "route": "/automations/new",
      "title": "Automation builder, step 3: AI and context",
      "purpose": "Topic and direction, tone, body length and format, image source, text model and optional knowledge documents. Then Next.",
      "openable": false,
      "fields": [
        {
          "name": "provider",
          "label": "AI provider",
          "type": "select",
          "required": true
        },
        {
          "name": "model",
          "label": "Model",
          "type": "text",
          "required": false
        },
        {
          "name": "topic",
          "label": "Topic and content brief",
          "type": "textarea",
          "required": true
        },
        {
          "name": "tone",
          "label": "Editorial tone",
          "type": "text",
          "required": false
        },
        {
          "name": "length",
          "label": "Body length",
          "type": "select",
          "required": false,
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        {
          "name": "content_format",
          "label": "Body format",
          "type": "select",
          "required": false,
          "enum": [
            "markdown",
            "html"
          ]
        },
        {
          "name": "image_provider",
          "label": "Image source for image columns",
          "type": "select",
          "required": false,
          "enum": [
            "auto",
            "openai",
            "gemini",
            "local"
          ]
        },
        {
          "name": "image_style",
          "label": "Optional image style",
          "type": "text",
          "required": false
        },
        {
          "name": "documents",
          "label": "Knowledge documents to ground the content (comma-separated titles; empty for none)",
          "type": "text",
          "required": false
        }
      ],
      "actions": [
        {
          "id": "back",
          "label": "Previous step",
          "consequential": false,
          "timeout_s": 10
        },
        {
          "id": "next",
          "label": "Next step",
          "consequential": false,
          "timeout_s": 15
        }
      ]
    },
    {
      "id": "builder.schedule",
      "route": "/automations/new",
      "title": "Automation builder, step 4: schedule and approval",
      "purpose": "One-time, daily or weekly; timezone; start date and optional end date (run until); weekdays for weekly; generation time and publication time at least 15 minutes later; approval email and the no-response policy. Then Next.",
      "openable": false,
      "fields": [
        {
          "name": "frequency",
          "label": "Schedule frequency",
          "type": "select",
          "required": true,
          "enum": [
            "DAILY",
            "WEEKLY",
            "ONE_TIME"
          ]
        },
        {
          "name": "start_date",
          "label": "Start date, or the run date for one-time (YYYY-MM-DD)",
          "type": "text",
          "required": true
        },
        {
          "name": "generation_time",
          "label": "Background generation time (HH:MM)",
          "type": "text",
          "required": true
        },
        {
          "name": "publication_time",
          "label": "Publication time (HH:MM, at least 15 minutes after generation)",
          "type": "text",
          "required": true
        },
        {
          "name": "require_approval",
          "label": "Require email approval",
          "type": "select",
          "required": false,
          "enum": [
            "true",
            "false"
          ]
        },
        {
          "name": "reviewer_email",
          "label": "Reviewer email",
          "type": "text",
          "required": false
        },
        {
          "name": "end_date",
          "label": "Run until (YYYY-MM-DD, empty = no end date)",
          "type": "text",
          "required": false
        },
        {
          "name": "weekly_days",
          "label": "Weekdays for weekly runs (ISO numbers, e.g. 1,4 = Monday, Thursday)",
          "type": "text",
          "required": false
        },
        {
          "name": "timezone",
          "label": "Timezone (IANA, e.g. Asia/Kolkata)",
          "type": "text",
          "required": true
        },
        {
          "name": "timeout_policy",
          "label": "If nobody approves by the publication time",
          "type": "select",
          "required": false,
          "enum": [
            "KEEP_DRAFT",
            "AUTO_PUBLISH_LATEST",
            "CANCEL"
          ]
        }
      ],
      "actions": [
        {
          "id": "back",
          "label": "Previous step",
          "consequential": false,
          "timeout_s": 10
        },
        {
          "id": "next",
          "label": "Next step",
          "consequential": false,
          "timeout_s": 15
        }
      ]
    },
    {
      "id": "builder.review",
      "route": "/automations/new",
      "title": "Automation builder, step 5: preview and enable",
      "purpose": "Optionally preview generated content, then create the automation.",
      "openable": false,
      "fields": [],
      "actions": [
        {
          "id": "preview",
          "label": "Generate a preview sample",
          "consequential": false,
          "timeout_s": 240
        },
        {
          "id": "back",
          "label": "Previous step",
          "consequential": false,
          "timeout_s": 10
        },
        {
          "id": "create",
          "label": "Create and enable the automation",
          "consequential": true,
          "timeout_s": 45,
          "verifies": "Automation"
        }
      ]
    },
    {
      "id": "manual.form",
      "route": "/manual-schedule",
      "title": "Manual publishing form",
      "purpose": "Write and publish (or schedule) one row without AI into a connected table. Only tables that may be written are offered. Choose the connection and table first; read_screen lists that table's columns, which you fill as col.<column_name>. A linked column (for example category_id) takes an existing row's id, or a name: then a new linked row is added first in the same transaction (an existing row with that name is reused).",
      "openable": false,
      "fields": [
        {
          "name": "connection",
          "label": "Target connection",
          "type": "searchable_select",
          "required": true
        },
        {
          "name": "table",
          "label": "Target table",
          "type": "searchable_select",
          "required": true
        },
        {
          "name": "col.*",
          "label": "Column value (col.<column_name>)",
          "type": "text",
          "required": false,
          "dynamic": true
        },
        {
          "name": "publish_mode",
          "label": "Publish now or schedule",
          "type": "select",
          "required": true,
          "enum": [
            "NOW",
            "SCHEDULED"
          ]
        },
        {
          "name": "scheduled_time",
          "label": "Scheduled date and time (YYYY-MM-DDTHH:MM)",
          "type": "text",
          "required": false
        },
        {
          "name": "ai_topic",
          "label": "Topic for the optional AI draft helper",
          "type": "textarea",
          "required": false
        }
      ],
      "actions": [
        {
          "id": "ai_draft",
          "label": "Fill the form with an AI draft from the topic",
          "consequential": false,
          "timeout_s": 240
        },
        {
          "id": "review",
          "label": "Check the row against the database and open the review (nothing is written)",
          "consequential": false,
          "timeout_s": 60
        },
        {
          "id": "publish",
          "label": "Publish now or schedule the record",
          "consequential": true,
          "timeout_s": 60,
          "verifies": "AutomationExecution"
        }
      ]
    },
    {
      "id": "approvals.list",
      "route": "/approvals",
      "title": "Approvals",
      "purpose": "AI drafts waiting for approval. Row actions take the draft id (from read_screen) as row.",
      "openable": false,
      "fields": [
        {
          "name": "reject_feedback",
          "label": "Rejection feedback (used to regenerate)",
