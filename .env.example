# Application Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Platform Internal Database (SQLite by default, PostgreSQL supported)
PLATFORM_DATABASE_URL=sqlite:///./platform_data.db

# Security & Tokens (Change in production!)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-local-demo
TOKEN_EXPIRY_HOURS=24

# AI & LLM Configuration
# Primary: Local Ollama (No paid API needed)
DEFAULT_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Optional Cloud AI Providers (Leave blank if not using)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Email & Notification Settings (SMTP or Local Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=automations@example.com
SMTP_USE_TLS=false

# Default Demo MySQL Database Target
DEMO_MYSQL_HOST=127.0.0.1
DEMO_MYSQL_PORT=3308
DEMO_MYSQL_USER=ipo_user
DEMO_MYSQL_PASSWORD=ipo_password
DEMO_MYSQL_DATABASE=demo_blog_cms
